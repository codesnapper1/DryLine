# Copy to .env (gitignored, never commit it). All three are optional individually —
# the app boots and serves cached/precomputed sessions with zero keys set.
# Live VLM inference needs at least one for the provider chain to have
# somewhere to fail over from.
#
# Provider chain order (backend/vlm.py): Google AI Studio -> Groq -> OpenRouter.

# Google AI Studio (gemini-2.5-flash, JSON schema mode) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (Llama 4 Scout vision, fast fallback) — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (any :free vision model, insurance fallback) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
